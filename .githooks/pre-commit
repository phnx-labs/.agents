#!/bin/bash
# Pre-commit hook: validate YAML in skills and configs
# Install EITHER form - both make git run this file:
#   git config core.hooksPath .githooks
#   ln -s ../../.githooks/pre-commit .git/hooks/pre-commit   # what this repo uses
# With neither, git never runs this file and every gate below is inert.
# See AGENTS.md, "The commit gates are opt-in", for how to verify which is live.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
ERRORS=0

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

# Ensure yq is available
ensure_yq() {
    if command -v yq &>/dev/null; then
        return 0
    fi

    echo -e "${YELLOW}yq not found, installing...${NC}"
    if [[ "$(uname)" == "Darwin" ]]; then
        brew install yq
    elif command -v apt-get &>/dev/null; then
        sudo apt-get update && sudo apt-get install -y yq
    elif command -v yum &>/dev/null; then
        sudo yum install -y yq
    else
        echo -e "${RED}Cannot install yq automatically. Please install manually.${NC}"
        exit 1
    fi
}

# Check the full staged path list before any dependency setup. NUL delimiters keep
# unusual but valid filenames from being quoted or split before policy evaluation.
AGENTS_PATHS=()
while IFS= read -r -d '' file; do
    case "$file" in
        .agents/plans/*) ;;
        .agents|.agents/*) AGENTS_PATHS[${#AGENTS_PATHS[@]}]="$file" ;;
    esac
done < <(git diff --cached --name-only -z)

if [[ ${#AGENTS_PATHS[@]} -gt 0 ]]; then
    echo -e "${RED}Commit blocked: .agents/ contains local agent output outside tracked .agents/plans/.${NC}" >&2
    printf '  %s\n' "${AGENTS_PATHS[@]}" >&2
    exit 1
fi

# An unresolved merge conflict reached main in CHANGELOG.md (markers committed at
# lines 7/22/42) because nothing here looked for them. Check the staged CONTENT,
# not the working tree, so a partial `git add` of a half-resolved file is caught.
# A lone '=======' is caught too: a half-resolution that deletes the outer two
# markers still corrupts the file, and in Markdown a bare '=======' is a setext H1
# underline, so it renders as a heading rather than failing loudly. Measured cost
# before adding it: `rg -n '^=======$'` matched exactly one line in this repo, the
# defect itself, so there is no legitimate setext usage to break.
CONFLICTED=()
OUTER_SEEN=0
while IFS= read -r -d '' file; do
    staged=$(git show ":$file" 2>/dev/null)
    if printf '%s' "$staged" | grep -qE '^(<<<<<<< |>>>>>>> |=======$)'; then
        CONFLICTED[${#CONFLICTED[@]}]="$file"
        # Track whether any real outer marker is present, so the setext hint below
        # is only offered when a lone separator is the ONLY thing that matched.
        if printf '%s' "$staged" | grep -qE '^(<<<<<<< |>>>>>>> )'; then
            OUTER_SEEN=1
        fi
    fi
done < <(git diff --cached --name-only --diff-filter=ACM -z)

if [[ ${#CONFLICTED[@]} -gt 0 ]]; then
    echo -e "${RED}Commit blocked: unresolved merge conflict markers in staged content.${NC}" >&2
    printf '  %s\n' "${CONFLICTED[@]}" >&2
    echo "Resolve the conflict and restage before committing." >&2
    if [[ $OUTER_SEEN -eq 0 ]]; then
        echo "A lone '=======' counts: it is the middle marker of a half-resolved" >&2
        echo "conflict. If you meant a Markdown setext heading, use '# Heading' instead." >&2
    fi
    exit 1
fi

# Extension validation applies only to staged files that still exist.
STAGED=$(git diff --cached --name-only --diff-filter=ACM)

# Only install yq when a file that actually uses it is staged.
if echo "$STAGED" | grep -qE '(\.yaml|\.yml|/SKILL\.md)$'; then
    ensure_yq
fi

# Print only the first YAML frontmatter block (between the first two `---`
# lines). Body markdown horizontal rules (`---`) are ignored — extraction stops
# at the closing delimiter rather than re-triggering on every `---` in the body.
extract_frontmatter() {
    awk 'NR==1 && $0=="---" {inside=1; next} inside && $0=="---" {exit} inside {print}' "$1"
}

validate_yaml_frontmatter() {
    local file="$1"
    local frontmatter
    frontmatter=$(extract_frontmatter "$file")

    [[ -z "$frontmatter" ]] && return 0

    if ! echo "$frontmatter" | yq '.' >/dev/null 2>&1; then
        echo "$frontmatter" | yq '.' 2>&1 | head -3
        return 1
    fi
}

validate_yaml_file() {
    local file="$1"
    if ! yq '.' "$file" >/dev/null 2>&1; then
        yq '.' "$file" 2>&1 | head -3
        return 1
    fi
}

validate_json_file() {
    local file="$1"
    if command -v jq &>/dev/null; then
        if ! jq '.' "$file" >/dev/null 2>&1; then
            return 1
        fi
    else
        if ! python3 -c "import json; json.load(open('$file'))" >/dev/null 2>&1; then
            return 1
        fi
    fi
}

echo "Validating staged files..."

for file in $STAGED; do
    [[ ! -f "$REPO_ROOT/$file" ]] && continue

    case "$file" in
        */SKILL.md)
            frontmatter=$(extract_frontmatter "$REPO_ROOT/$file")
            if [[ -z "$frontmatter" ]]; then
                echo -e "${RED}✗ Missing YAML frontmatter:${NC} $file"
                ((ERRORS++))
            elif ! result=$(validate_yaml_frontmatter "$REPO_ROOT/$file" 2>&1); then
                echo -e "${RED}✗ Invalid YAML frontmatter:${NC} $file"
                echo "  $result"
                ((ERRORS++))
            else
                echo -e "${GREEN}✓${NC} $file"
            fi
            ;;
        *.yaml|*.yml)
            if ! result=$(validate_yaml_file "$REPO_ROOT/$file" 2>&1); then
                echo -e "${RED}✗ Invalid YAML:${NC} $file"
                echo "  $result"
                ((ERRORS++))
            else
                echo -e "${GREEN}✓${NC} $file"
            fi
            ;;
        *.json)
            if ! result=$(validate_json_file "$REPO_ROOT/$file" 2>&1); then
                echo -e "${RED}✗ Invalid JSON:${NC} $file"
                ((ERRORS++))
            else
                echo -e "${GREEN}✓${NC} $file"
            fi
            ;;
    esac
done

if [[ $ERRORS -gt 0 ]]; then
    echo ""
    echo -e "${RED}Commit blocked: $ERRORS validation error(s)${NC}"
    exit 1
fi

exit 0
