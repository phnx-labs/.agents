# Local-only directories (not synced to repo)
/tests/
/sessions/
/versions/
/shims/
/repos/
/runs/
# NOTE: routines/ is tracked here — this source repo SHIPS built-in routines
# (e.g. routines/check-updates.yml) that installs receive via `agents repo pull
# system`. In a user's ~/.agents the routines/ dir is their own runtime state; it
# is only ignored there, never here.
/drives/
/packages/
/swarm/
/agents/
/backups/
/growth/
/logs/
/factory/
/ledger/

# Local-only permissions (machine-specific, not synced)
permissions/groups/00-local.yaml
permissions/default.yml

# Private skills (local only, not version controlled)
# Add your own private skill paths here in forks:
#   skills/your-private-skill/

# Machine-specific environment (secrets, hosts, paths)
/.environment
/secrets

# Local state files
*.log
*.pid
.update-check
meta.yaml
cache.json
config.json
prompts.json

# System-generated skills
skills/.system/

# OS files
.DS_Store
.AppleDouble
.LSOverride

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temporary files
*.tmp
*~
__pycache__/
linear.json
/.repos/

# Runtime state, caches, and live process tracking
/.cli-version-cache.json
/.models-cache.json
/.migrated
/rotate-stamp-*.json
/bin/
/browser/
/cache/
/cloud/
/drive/
/helpers/
/state/
# Subagent definitions are user-layer, never shipped — but the directory's
# README is documentation and must travel with the repo. Ignore the CONTENTS,
# not the directory: git cannot re-include a file whose parent dir is excluded.
/subagents/*
!/subagents/README.md
/swarmify/
/teams/

# Local planning notes (not for upstream)
/.plans/

# Background sync state (lock + status markers)
/.fetch/

# Local, machine-specific artifacts that must never block `agents repo pull system`.
# These are written into ~/.agents/.system at runtime (per-box) but are not source:
# an ungitignored one silently blocks every pull, drifting .system behind fleet-wide.
.mcp.json
/.worktrees/
# Agent worktrees, rendered artifacts, and scratch are per-box outputs. Reviewed
# implementation plans are durable PR artifacts.
/.agents/*
!/.agents/plans/
